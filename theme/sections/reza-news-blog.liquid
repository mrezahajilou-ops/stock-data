{%- if blog.handle == 'portfolio' -%}
<script>location.replace('/pages/portfolio#comm');</script>
<p style="text-align:center;padding:60px 16px;font-family:Vazirmatn,Tahoma,sans-serif"><a href="/pages/portfolio#comm">جامعه‌ی پورتفوی رضا</a></p>
{%- else -%}
{%- render 'reza-news-css' -%}
{%- assign p = section.settings.product -%}
<div class="rzn">
  <div class="rzn-wrap">
    <div class="rzn-head">
      <div>
        <span class="rzn-live">آخرین مطالب</span>
        <h1>{{ section.settings.heading }}</h1>
        <p>{{ section.settings.subheading }}</p>
      </div>
    </div>

    {%- if blog.all_tags.size > 0 -%}
      {%- comment -%} Nov 2026: 45+ topics made a five-row wall above the articles. The main topics stay visible;
        the rest fold under "موضوعات بیشتر" (opened automatically when the current filter is one of them). {%- endcomment -%}
      {%- if blog.handle == 'earnings-reports' -%}
        {%- assign pri = 'فناوری|مالی|سلامت و دارو|انرژی|صنعتی|کالاهای مصرفی غیرضروری|کالاهای مصرفی ضروری|خدمات عمومی|املاک و مستغلات|مواد اولیه|مخابرات' | split: '|' -%}
      {%- else -%}
        {%- assign pri = 'خبر|گزارش فصلی|بازار امروز|بورس آمریکا|هوش مصنوعی|بهترین سهام|آموزش|تحلیل بنیادی|طلا' | split: '|' -%}
      {%- endif -%}
      {%- assign rest_open = false -%}
      {%- assign rest_n = 0 -%}
      {%- for tag in blog.all_tags -%}
        {%- unless pri contains tag -%}
          {%- assign rest_n = rest_n | plus: 1 -%}
          {%- if current_tags contains tag -%}{%- assign rest_open = true -%}{%- endif -%}
        {%- endunless -%}
      {%- endfor -%}
      <div class="rzn-tags">
        <a href="{{ blog.url }}" class="{% unless current_tags %}on{% endunless %}">همه</a>
        {%- for t in pri -%}
          {%- if blog.all_tags contains t -%}
            <a href="{{ blog.url }}/tagged/{{ t | handleize }}" class="{% if current_tags contains t %}on{% endif %}">{{ t }}</a>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- if rest_n > 0 -%}
        <details class="rzn-more"{% if rest_open %} open{% endif %}>
          <summary>{% if blog.handle == 'earnings-reports' %}همه‌ی شرکت‌ها{% else %}موضوعات بیشتر{% endif %} <span>({{ rest_n }})</span></summary>
          {%- if rest_n > 30 -%}<input class="rzn-find" type="search" placeholder="جستجوی نام یا نماد شرکت…" aria-label="جستجو"
            oninput="var q=this.value.trim().toLowerCase();this.nextElementSibling.querySelectorAll('a').forEach(function(a){a.style.display=!q||a.textContent.toLowerCase().indexOf(q)>-1?'':'none'})">{%- endif -%}
          <div class="rzn-tags">
            {%- for tag in blog.all_tags -%}
              {%- unless pri contains tag -%}
                <a href="{{ blog.url }}/tagged/{{ tag | handleize }}" class="{% if current_tags contains tag %}on{% endif %}">{{ tag }}</a>
              {%- endunless -%}
            {%- endfor -%}
          </div>
        </details>
      {%- endif -%}
      <style>
        .rzn-more{margin:-6px 0 18px}
        .rzn-more>summary{cursor:pointer;list-style:none;display:inline-flex;align-items:center;gap:6px;padding:6px 16px;border:1px dashed var(--rz-line,#2a3a52);
          border-radius:999px;color:var(--rz-gold,#C9A961);font-size:14px;font-weight:700;user-select:none}
        .rzn-more>summary::-webkit-details-marker{display:none}
        .rzn-more>summary::after{content:'▾';font-size:12px}
        .rzn-more[open]>summary::after{content:'▴'}
        .rzn-more>summary span{color:var(--rz-mut,#8a9bb3);font-weight:500}
        .rzn-more[open]>summary{margin-bottom:10px}
        .rzn-find{display:block;width:100%;max-width:360px;margin:0 0 10px;padding:9px 14px;border-radius:12px;border:1px solid var(--rz-line,#2a3a52);
          background:transparent;color:inherit;font:inherit;font-size:14px;box-sizing:border-box}
        .rzn-more .rzn-tags{max-height:340px;overflow:auto}
      </style>
    {%- endif -%}

    {%- if p -%}{%- render 'reza-book-card', product: p, style: 'compact' -%}{%- endif -%}

    {%- paginate blog.articles by 13 -%}
      {%- if blog.articles.size == 0 -%}
        <div class="rzn-empty">به‌زودی اولین مطالب اینجا منتشر می‌شود.</div>
      {%- else -%}
        <div class="rzn-grid">
          {%- for article in blog.articles -%}
            <a class="rzn-card{% if forloop.first and paginate.current_page == 1 %} rzn-card--lead{% endif %}" href="{{ article.url }}">
              {%- if article.image -%}
                <img src="{{ article.image | image_url: width: 900 }}" alt="{{ article.image.alt | default: article.title | escape }}" loading="lazy">
              {%- endif -%}
              <div class="in">
                <div class="rzn-meta">
                  {%- if article.tags.size > 0 -%}<span class="rzn-cat">{{ article.tags.first }}</span>{%- endif -%}
                  <span>{{ article.published_at | date: '%Y/%m/%d' }}</span>
                </div>
                <h2>{{ article.title }}</h2>
                {%- if article.excerpt != blank -%}<p>{{ article.excerpt | strip_html | truncate: 150 }}</p>{%- endif -%}
              </div>
            </a>
            {%- if forloop.index == 4 and p -%}
              <div class="rzn-slot">{%- render 'reza-book-card', product: p, style: 'wide' -%}</div>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}
          <div class="rzn-pag">{{ paginate | default_pagination: previous: '→ جدیدتر', next: 'قدیمی‌تر ←' }}</div>
        {%- endif -%}
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>
{%- if p -%}
  {%- assign sv = p.selected_or_first_available_variant -%}
  <div class="rzn-sticky"><span>📘 کتاب آموزش بورس · {{ sv.price | money }}</span><a href="/cart/{{ sv.id }}:1">خرید کتاب</a></div>
{%- endif -%}

{%- endif -%}

{% schema %}
{
  "name": "Reza news list",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "اخبار و مقالات" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "خبرها و مقاله‌های مهم بورس، اقتصاد و سیاست؛ با توضیح ساده و نظر رضا حاجیلو" },
    { "type": "product", "id": "product", "label": "Book product" }
  ]
}
{% endschema %}
