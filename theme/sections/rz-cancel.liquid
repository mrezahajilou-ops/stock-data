{%- comment -%}
  Cancellation page (Kündigungsbutton flow, §312k BGB). Footer button -> this confirmation page -> "jetzt kündigen".
  Sent as a Shopify contact message (body starts with RZ-KUENDIGUNG); a GitHub Actions job (cancel_confirm.py) reads it from
  the shop inbox and emails the customer a confirmation with the received time. After submitting, the page shows the same
  details with the time of receipt and a button to save/print them.
{%- endcomment -%}
<div class="rzc" dir="rtl">
  <h1>لغو اشتراک <span lang="de" dir="ltr">Vertrag kündigen</span></h1>

  {%- form 'contact', id: 'rzc-form' -%}
    {%- if form.posted_successfully? -%}
      <div class="rzc-ok" id="rzc-ok">
        <h2>✅ درخواست لغو دریافت شد <span lang="de" dir="ltr">Kündigung eingegangen</span></h2>
        <dl id="rzc-sum"></dl>
        <p>یک ایمیل تأیید با همین جزئیات و زمان دریافت برات فرستاده می‌شه. <span lang="de" dir="ltr">Du erhältst eine Bestätigung per E-Mail.</span></p>
        <button type="button" class="rzc-btn2" onclick="window.print()">ذخیره / چاپ <span dir="ltr">Speichern / Drucken</span></button>
      </div>
    {%- else -%}
      <p class="rzc-lead">برای لغو، فرم زیر رو پر کن و دکمه‌ی «الان لغو کن» رو بزن. اگه وارد حسابت هستی، می‌تونی از <a href="{{ routes.account_url }}">حساب من ← اشتراک‌ها</a> هم مستقیم لغو کنی.<br><span lang="de" dir="ltr">Bitte fülle das Formular aus und klicke auf „jetzt kündigen“.</span></p>
      {%- if form.errors -%}<div class="rzc-err">{{ form.errors | default_errors }}</div>{%- endif -%}
      <input type="hidden" name="contact[body]" value="RZ-KUENDIGUNG">

      <label>نام و نام خانوادگی <small dir="ltr">Name</small>
        <input name="contact[name]" required autocomplete="name" value="{{ customer.name }}"></label>

      <label>ایمیلی که باهاش خرید کردی <small dir="ltr">E-Mail-Adresse</small>
        <input type="email" name="contact[email]" required dir="ltr" autocomplete="email" value="{{ customer.email }}"></label>

      <label>کدوم قرارداد؟ <small dir="ltr">Vertrag</small>
        <select name="contact[Vertrag]" required>
          <option value="Stock Pro – monatlich (اشتراک ماهانه Stock Pro)">اشتراک ماهانه Stock Pro</option>
          <option value="Stock Pro – jährlich (اشتراک سالانه Stock Pro)">اشتراک سالانه Stock Pro</option>
          <option value="Portfolio Reza – jährlich (اشتراک سالانه پورتفوی رضا)">اشتراک سالانه پورتفوی رضا</option>
        </select></label>

      <label>شماره سفارش (اختیاری) <small dir="ltr">Bestellnummer (optional)</small>
        <input name="contact[Bestellnummer]" dir="ltr" placeholder="#1001"></label>

      <fieldset><legend>نوع لغو <small dir="ltr">Art der Kündigung</small></legend>
        <label class="r"><input type="radio" name="contact[Kuendigungsart]" value="ordentliche Kündigung (لغو عادی)" checked> لغو عادی <small dir="ltr">ordentliche Kündigung</small></label>
        <label class="r"><input type="radio" name="contact[Kuendigungsart]" value="außerordentliche Kündigung (لغو فوری با دلیل)"> لغو فوری با دلیل <small dir="ltr">außerordentliche Kündigung</small></label>
      </fieldset>
      <label id="rzc-grund" hidden>دلیل لغو فوری <small dir="ltr">Kündigungsgrund</small>
        <textarea name="contact[Grund]" rows="3"></textarea></label>

      <fieldset><legend>از کی؟ <small dir="ltr">Zeitpunkt</small></legend>
        <label class="r"><input type="radio" name="rzc_when" value="asap" checked> اولین زمان ممکن <small dir="ltr">zum nächstmöglichen Zeitpunkt</small></label>
        <label class="r"><input type="radio" name="rzc_when" value="date"> از تاریخ <small dir="ltr">zum Datum</small> <input type="date" id="rzc-date" dir="ltr"></label>
      </fieldset>
      <input type="hidden" name="contact[Zeitpunkt]" id="rzc-zp" value="zum nächstmöglichen Zeitpunkt (اولین زمان ممکن)">

      <button type="submit" class="rzc-btn">الان لغو کن <span dir="ltr">jetzt kündigen</span></button>
    {%- endif -%}
  {%- endform -%}
</div>
<style>
  .rzc{max-width:620px;margin:0 auto;padding:28px 16px 48px;font-family:'Vazirmatn',Tahoma,sans-serif;line-height:1.9}
  .rzc h1{font-size:26px;margin:0 0 10px}
  .rzc h1 span,.rzc h2 span{display:block;font-size:.6em;opacity:.7;font-weight:600}
  .rzc-lead{font-size:14.5px;opacity:.85;margin:0 0 18px}
  .rzc label{display:block;margin:0 0 14px;font-weight:700;font-size:14.5px}
  .rzc small{font-weight:400;opacity:.7;font-size:12px}
  .rzc input:not([type=radio]),.rzc select,.rzc textarea{display:block;width:100%;margin-top:4px;padding:10px 12px;font-size:16px;border:1.5px solid rgba(128,128,128,.4);border-radius:10px;background:transparent;color:inherit;font-family:inherit;box-sizing:border-box}
  .rzc fieldset{border:1.5px solid rgba(128,128,128,.3);border-radius:12px;margin:0 0 14px;padding:8px 14px 0}
  .rzc legend{font-weight:700;font-size:14.5px;padding:0 6px}
  .rzc label.r{font-weight:500;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
  .rzc label.r input[type=date]{width:auto;display:inline-block;margin:0;padding:4px 8px;font-size:14px}
  .rzc-btn{width:100%;padding:14px;font-size:17px;font-weight:800;border:0;border-radius:12px;background:#c0392b;color:#fff;cursor:pointer;font-family:inherit}
  .rzc-btn span{font-weight:600;opacity:.85;margin-right:6px}
  .rzc-btn2{padding:10px 18px;font-size:15px;font-weight:700;border-radius:10px;border:1.5px solid currentColor;background:transparent;color:inherit;cursor:pointer;font-family:inherit}
  .rzc-ok{border:1.5px solid #2e9e6a;border-radius:14px;padding:16px 18px}
  .rzc-ok h2{font-size:20px;margin:0 0 10px}
  .rzc-ok dl{display:grid;grid-template-columns:auto 1fr;gap:4px 14px;margin:0 0 12px;font-size:14px}
  .rzc-ok dt{opacity:.7}
  .rzc-ok dd{margin:0;font-weight:700;overflow-wrap:anywhere}
  .rzc-err{color:#c0392b;margin-bottom:12px}
  @media print{header,footer,.rz-kb,.rzc-btn2,.shopify-section-group-header-group,.shopify-section-group-footer-group{display:none!important}}
</style>
<script>
(function(){
  var K='rzc_last';
  var f=document.getElementById('rzc-form');
  var sum=document.getElementById('rzc-sum');
  if(sum){
    var d=null;try{d=JSON.parse(sessionStorage.getItem(K)||'null')}catch(e){}
    var rows=d?d.rows:[];
    rows.push(['زمان دریافت / Eingang', new Date().toLocaleString('de-DE',{dateStyle:'long',timeStyle:'short'})]);
    sum.innerHTML=rows.map(function(r){var t=document.createElement('div');t.textContent=r[1];return '<dt>'+r[0]+'</dt><dd dir="auto">'+t.innerHTML+'</dd>'}).join('');
    return;
  }
  if(!f)return;
  var zp=document.getElementById('rzc-zp'),dt=document.getElementById('rzc-date'),gr=document.getElementById('rzc-grund');
  function upd(){
    var w=(f.querySelector('[name=rzc_when]:checked')||{}).value;
    zp.value=(w==='date'&&dt.value)?('zum '+dt.value.split('-').reverse().join('.')+' (از تاریخ '+dt.value+')'):'zum nächstmöglichen Zeitpunkt (اولین زمان ممکن)';
    var a=(f.querySelector('[name="contact[Kuendigungsart]"]:checked')||{}).value||'';
    gr.hidden=a.indexOf('außer')<0;
  }
  f.addEventListener('change',upd);dt.addEventListener('input',function(){f.querySelector('[name=rzc_when][value=date]').checked=true;upd()});
  f.addEventListener('submit',function(){
    upd();
    var g=function(n){var e=f.querySelector('[name="'+n+'"]');return e?e.value:''};
    var rows=[['نام / Name',g('contact[name]')],['ایمیل / E-Mail',g('contact[email]')],['قرارداد / Vertrag',g('contact[Vertrag]')],
      ['نوع لغو / Art',(f.querySelector('[name="contact[Kuendigungsart]"]:checked')||{}).value||''],['از کی / Zeitpunkt',zp.value]];
    if(g('contact[Bestellnummer]'))rows.push(['سفارش / Bestellung',g('contact[Bestellnummer]')]);
    try{sessionStorage.setItem(K,JSON.stringify({rows:rows}))}catch(e){}
  });
})();
</script>
{% schema %}
{"name":"Kündigung","settings":[]}
{% endschema %}
