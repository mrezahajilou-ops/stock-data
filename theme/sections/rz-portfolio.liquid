{%- comment -%}
  Reza's portfolio. Holdings/trades are rendered into the HTML ONLY for subscribers (server-side check).
  Visitors see the header stats, portfolio value and performance chart; holdings, trades and posts are subscribers only. Page code: web/portfolio.html in GitHub.
  Trades: Shopify admin -> Content -> Metaobjects -> "Portfolio trade". Notes: blog "portfolio".
{%- endcomment -%}
{%- capture rzp_acc -%}{%- render 'rz-portfolio-access' -%}{%- endcapture -%}
{%- assign rzp_access = false -%}{%- if rzp_acc contains '1' -%}{%- assign rzp_access = true -%}{%- endif -%}
{%- assign pm = metaobjects.rz_portfolio.main -%}
{%- comment -%} trade-alert email status from customer tags: alert-to:<unix>:<email> (on) / alert-off:<unix> (off); newest wins {%- endcomment -%}
{%- assign al_on_ts = 0 -%}{%- assign al_off_ts = 0 -%}{%- assign al_to = '' -%}
{%- if customer -%}{%- for t in customer.tags -%}
  {%- if t contains 'alert-to:' -%}{%- assign tp = t | split: ':' -%}{%- assign tts = tp[1] | plus: 0 -%}{%- if tts > al_on_ts -%}{%- assign al_on_ts = tts -%}{%- assign al_to = tp[2] -%}{%- endif -%}
  {%- elsif t contains 'alert-off:' -%}{%- assign tp = t | split: ':' -%}{%- assign tts = tp[1] | plus: 0 -%}{%- if tts > al_off_ts -%}{%- assign al_off_ts = tts -%}{%- endif -%}{%- endif -%}
{%- endfor -%}{%- endif -%}
{%- assign al_on = false -%}{%- if al_on_ts > 0 and al_on_ts > al_off_ts -%}{%- assign al_on = true -%}{%- endif -%}
<script>
window.RZP = {
  access: {{ rzp_access | json }},
  logged: {% if customer %}true{% else %}false{% endif %},
  email: {{ customer.email | json }},
  alerts: { on: {{ al_on | json }}, to: {{ al_to | json }} },
  sub: '/products/portfolio-pro',
  login: '/account/login?return_url=%2Fpages%2Fportfolio',
  meta: {{ pm.meta.value | json }},
  hist: {{ pm.history.value | json }},
  live: {{ pm.live.value | json }},
  vlast: {{ pm.values.value | last | last | json }},
  {%- if rzp_access %}
  posts: [{%- for a in blogs.portfolio.articles limit: 30 -%}{"h":{{ a.title | json }},"u":{{ a.url | json }},"d":{{ a.published_at | date: '%Y-%m-%d' | json }},"c":{{ a.comments_count | default: 0 }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}],
  trades: [{%- paginate metaobjects.rz_trade.values by 250 -%}{%- for t in metaobjects.rz_trade.values -%}{"d":{{ t.date.value | date: '%s' | plus: 0 }},"a":{{ t.action.value | json }},"t":{{ t.ticker.value | json }},"n":{{ t.shares.value | json }},"p":{{ t.price.value | json }},"m":{{ t.amount.value | json }},"x":{{ t.note.value | json }},"h":{{ t.history_only.value | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}{%- endpaginate -%}]
  {%- endif %}
};
</script>
<div style="padding:18px 0 48px">
  {% render 'rz-app', app: 'portfolio' %}
</div>

{% schema %}
{ "name": "Reza portfolio v2", "settings": [] }
{% endschema %}
