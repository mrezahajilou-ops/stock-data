{%- comment -%}
  Quick links on every page: home, stock analysis, contest, account. Tool pages (rz-app) draw the same bar themselves (gen_web.py ACCT),
  so this one hides itself when the page contains an rz-app container.
{%- endcomment -%}
<div class="rzgt" dir="rtl">
  {%- unless template.name == 'index' -%}<a class="q" href="/">🏠 <span class="lg">صفحه اصلی</span><span class="sm">خانه</span></a>{%- endunless -%}
  {%- unless request.path == '/pages/stock' -%}<a class="q" href="/pages/stock">📊 تحلیل سهام</a>{%- endunless -%}
  <a class="q c" href="/pages/contest-portfolio">🏆 مسابقه</a>
  {%- if customer -%}<a class="a in" href="{{ routes.account_url }}">👤 حساب من</a>
  {%- else -%}<a class="a" href="{{ routes.account_login_url }}?return_url={{ request.path | url_encode }}">👤 <span class="lg">ورود مشترکین</span><span class="sm">ورود</span></a>{%- endif -%}
</div>
<style>
  .rzgt{display:flex;align-items:center;gap:6px;flex-wrap:wrap;max-width:var(--page-width,120rem);margin:0 auto;padding:12px 16px 0;
    font-family:'Vazirmatn',Tahoma,sans-serif;box-sizing:border-box}
  .rzgt a{display:inline-flex;align-items:center;gap:4px;font-size:13px;font-weight:700;border-radius:999px;padding:5px 12px;
    text-decoration:none!important;white-space:nowrap;line-height:1.4}
  .rzgt .q{color:rgb(var(--color-foreground))!important;border:1px solid rgba(var(--color-foreground),.22)}
  .rzgt .q.c{color:#c9a961!important;border-color:rgba(201,169,97,.6)}
  .rzgt .a{margin-inline-start:auto;color:#15120a!important;background:#c9a961}
  .rzgt .a.in{background:transparent;color:#c9a961!important;border:1px solid #c9a961}
  body:has([id^="rz-app-"]) .rzgt{display:none}
  .rzgt .sm{display:none}
  @media (max-width:480px){.rzgt .lg{display:none}.rzgt .sm{display:inline}}
  @media (max-width:420px){.rzgt{gap:5px}.rzgt a{font-size:12px;padding:4px 9px}}
  @media (max-width:360px){.rzgt{gap:4px}.rzgt a{font-size:11px;padding:3px 7px}}
</style>
{% schema %}
{ "name": "Quick links bar", "settings": [] }
{% endschema %}
