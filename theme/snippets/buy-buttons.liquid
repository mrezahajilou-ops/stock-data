{% comment %}
  Product buy-buttons (Origin) for a digital store. Subscriptions (Stock Pro, portfolio) get one "اشتراک" button,
  no quantity, no "Buy it now", the plan picker (rz-selling-plans) and a short auto-renewal note.
{% endcomment %}
{%- liquid
  assign v = product.selected_or_first_available_variant
  assign rz_sub = false
  if product.requires_selling_plan or product.selling_plan_groups.size > 0 or product.type contains 'Subscription' or product.type contains 'اشتراک'
    assign rz_sub = true
  endif
  assign rz_label = 'شروع اشتراک'
  if product.title contains 'سالانه'
    assign rz_label = 'شروع اشتراک سالانه'
  elsif product.title contains 'ماهانه' or product.requires_selling_plan
    assign rz_label = 'شروع اشتراک ماهانه'
  endif
  assign show_dynamic_checkout = false
  if block.settings.show_dynamic_checkout and rz_sub == false
    assign show_dynamic_checkout = true
  endif
-%}
{%- if rz_sub -%}
  <style>.product-form__quantity,.product__info-container .quantity-popover-container,.product__info-container label.quantity__label{display:none!important}</style>
{%- endif -%}
<div {{ block.shopify_attributes }}>
  {%- if product != blank -%}
    <product-form class="product-form" data-hide-errors="false" data-section-id="{{ section.id }}">
      <div class="product-form__error-message-wrapper" role="alert" hidden>
        <span class="svg-wrapper">{{- 'icon-error.svg' | inline_asset_content -}}</span>
        <span class="product-form__error-message"></span>
      </div>
      {%- form 'product', product, id: product_form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
        <input type="hidden" name="id" value="{{ v.id }}" {% if v.available == false or v == null %}disabled{% endif %} class="product-variant-id">
        {%- if rz_sub -%}<input type="hidden" name="quantity" value="1">{%- endif -%}
        {%- render 'rz-selling-plans', product: product -%}
        <div class="product-form__buttons">
          <button id="ProductSubmitButton-{{ section_id }}" type="submit" name="add"
            class="product-form__submit button button--full-width {% if show_dynamic_checkout %}button--secondary{% else %}button--primary{% endif %}"
            {% if v.available == false or v == null %}disabled{% endif %}>
            <span>
              {%- if v == null -%}{{ 'products.product.unavailable' | t }}
              {%- elsif v.available == false -%}{{ 'products.product.sold_out' | t }}
              {%- elsif rz_sub -%}{{ rz_label }}
              {%- else -%}{{ 'products.product.add_to_cart' | t }}{%- endif -%}
            </span>
            {%- render 'loading-spinner' -%}
          </button>
          {%- if show_dynamic_checkout -%}{{ form | payment_button }}{%- endif -%}
        </div>
        {%- if rz_sub -%}
          <p class="rz-sub-note" style="margin:10px 0 0;font-size:12.5px;color:#8A8F99;direction:rtl;text-align:right;line-height:1.9">🔄 اشتراک تا وقتی لغوش نکنی خودکار تمدید می‌شه. لغو با یک کلیک از «حساب من ← اشتراک‌ها» یا صفحه‌ی <a href="/pages/cancel" style="color:inherit;text-decoration:underline">لغو قرارداد</a>. دسترسی بلافاصله بعد از پرداخت فعال می‌شه.</p>
        {%- endif -%}
      {%- endform -%}
    </product-form>
  {%- else -%}
    <div class="product-form"><div class="product-form__buttons form">
      <button type="submit" name="add" class="product-form__submit button button--full-width button--primary" disabled>{{ 'products.product.sold_out' | t }}</button>
    </div></div>
  {%- endif -%}
</div>
